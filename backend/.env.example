# PostgreSQL Database Connection
# Use the Supavisor Pooler (Port 6543) for IPv4 compatibility and serverless handling
# Mode: Transaction
# Format: postgresql://postgres.<PROJECT-REF>:[PASSWORD]@[POOLER-HOSTNAME]:6543/postgres
DATABASE_URL=postgresql://postgres.yourprojectref:yourpassword@aws-1-your-region.pooler.supabase.com:6543/postgres

# Project Settings
PROJECT_NAME="AI Job Matching API"
VERSION="1.0.0"
ENVIRONMENT="development"
HUGGING_FACE_API_TOKEN="your_hf_token_here"

# CORS
ALLOWED_ORIGINS="https://your-frontend.vercel.app,http://localhost:3000"

# Azure Always-Free Configuration
AZURE_COSMOS_CONNECTION_STRING="AccountEndpoint=https://your-name.documents.azure.com:443/;AccountKey=your-key;"
AZURE_COSMOS_DATABASE_ID="JobMatchingDB"
AZURE_COSMOS_CONTAINER_ID="EmbeddingsCache"
APPLICATIONINSIGHTS_CONNECTION_STRING="InstrumentationKey=your-key;IngestionEndpoint=https://your-region.in.applicationinsights.azure.com/"

# Supabase Storage (Optional Fallback)
SUPABASE_URL=your_supabase_url
SUPABASE_KEY=your_supabase_anon_key
